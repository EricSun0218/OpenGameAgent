{
	"name": "@opengameagent/server",
	"version": "0.1.0-alpha.0",
	"description": "Self-hosted Hono transport for OpenGameAgent",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -b --pretty false"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@opengameagent/actions": "0.1.0-alpha.0",
		"@opengameagent/protocol": "0.1.0-alpha.0",
		"@opengameagent/runtime": "0.1.0-alpha.0",
		"hono": "4.13.13",
		"typebox": "1.3.19"
	},
	"engines": {
		"node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EricSun0218/OpenGameAgent.git",
		"directory": "packages/server"
	},
	"bugs": {
		"url": "https://github.com/EricSun0218/OpenGameAgent/issues"
	}
}
