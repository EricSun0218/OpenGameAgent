{
	"name": "@opengameagent/media",
	"version": "0.1.0-alpha.0",
	"description": "Optional durable output media jobs for OpenGameAgent",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
