{
	"name": "@opengameagent/credentials-windows",
	"version": "0.1.0-alpha.0",
	"description": "Optional Windows CurrentUser DPAPI credential persistence for OpenGameAgent",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -b --pretty false"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@opengameagent/protocol": "0.1.0-alpha.0",
		"@primno/dpapi": "2.0.1",
		"fs-ext-extra-prebuilt": "2.2.13",
		"koffi": "3.1.6"
	},
	"engines": {
		"node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EricSun0218/OpenGameAgent.git",
		"directory": "packages/credentials-windows"
	},
	"bugs": {
		"url": "https://github.com/EricSun0218/OpenGameAgent/issues"
	}
}
