{
	"name": "@opengameagent/integrations",
	"version": "0.1.0-alpha.0",
	"description": "Optional standards-based integrations for OpenGameAgent",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas/agent-plugin-package-manifest-v1.schema.json": "./schemas/agent-plugin-package-manifest-v1.schema.json",
		"./schemas/agent-plugin-package-signatures-v1.schema.json": "./schemas/agent-plugin-package-signatures-v1.schema.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"schemas/*.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -b --pretty false"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.85.1",
		"@earendil-works/pi-ai": "0.85.1",
		"@modelcontextprotocol/sdk": "1.30.1",
		"@opengameagent/agent": "0.1.0-alpha.0",
		"@opengameagent/client": "0.1.0-alpha.0",
		"@opengameagent/health": "0.1.0-alpha.0",
		"@opengameagent/media": "0.1.0-alpha.0",
		"@opengameagent/protocol": "0.1.0-alpha.0",
		"@opengameagent/realtime": "0.1.0-alpha.0",
		"@opengameagent/realtime-local": "0.1.0-alpha.0",
		"execa": "10.0.1",
		"ollama": "0.6.3",
		"openai": "6.40.0",
		"typebox": "1.3.19",
		"ws": "8.21.3",
		"yaml": "2.9.0",
		"yocto-queue": "1.2.2"
	},
	"engines": {
		"node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EricSun0218/OpenGameAgent.git",
		"directory": "packages/integrations"
	},
	"bugs": {
		"url": "https://github.com/EricSun0218/OpenGameAgent/issues"
	}
}
