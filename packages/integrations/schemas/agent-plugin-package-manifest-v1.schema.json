{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:opengameagent:agent-plugin-package:manifest:1",
	"title": "OpenGameAgent signed Agent Plugin package manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "plugin", "releaseSequence", "files"],
	"properties": {
		"schema": {
			"const": "urn:opengameagent:agent-plugin-package:1"
		},
		"plugin": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version"],
			"properties": {
				"name": {
					"type": "string",
					"maxLength": 64,
					"pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
				},
				"version": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"releaseSequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"files": {
			"type": "array",
			"minItems": 1,
			"contains": {
				"type": "object",
				"required": ["path"],
				"properties": {
					"path": {
						"const": "plugin.json"
					}
				}
			},
			"minContains": 1,
			"maxContains": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "bytes", "sha256", "executable"],
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1
					},
					"bytes": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"sha256": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					},
					"executable": {
						"type": "boolean"
					}
				}
			}
		}
	}
}
