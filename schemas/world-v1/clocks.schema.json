{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EricSun0218/game-agent-runtime/main/schemas/world-v1/clocks.schema.json",
  "title": "Native World Clocks v1",
  "type": "object",
  "required": [
    "contract",
    "clocks"
  ],
  "properties": {
    "contract": {
      "const": "game-agent.world-clocks.v1"
    },
    "clocks": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "clockId",
          "statePath",
          "initialTick"
        ],
        "properties": {
          "clockId": {
            "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
          },
          "statePath": {
            "$ref": "native-world-common.schema.json#/$defs/jsonPointer"
          },
          "initialTick": {
            "$ref": "native-world-common.schema.json#/$defs/canonicalInt64"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "native-world-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
