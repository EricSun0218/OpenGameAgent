{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EricSun0218/game-agent-runtime/main/schemas/world-v1/events.schema.json",
  "title": "Native World Events v1",
  "type": "object",
  "required": [
    "contract",
    "events"
  ],
  "properties": {
    "contract": {
      "const": "game-agent.world-events.v1"
    },
    "events": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "required": [
          "definitionId",
          "version",
          "priority",
          "trigger",
          "selector",
          "condition",
          "effects"
        ],
        "properties": {
          "definitionId": {
            "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
          },
          "version": {
            "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
          },
          "priority": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "clockId",
                  "everyTicks"
                ],
                "properties": {
                  "kind": {
                    "const": "clock"
                  },
                  "clockId": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  },
                  "everyTicks": {
                    "$ref": "native-world-common.schema.json#/$defs/canonicalPositiveInt64"
                  },
                  "offsetTicks": {
                    "$ref": "native-world-common.schema.json#/$defs/canonicalInt64"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "eventKind"
                ],
                "properties": {
                  "kind": {
                    "const": "event"
                  },
                  "eventKind": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "singleton"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "entityId"
                ],
                "properties": {
                  "kind": {
                    "const": "entity"
                  },
                  "entityId": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  },
                  "incarnation": {
                    "$ref": "native-world-common.schema.json#/$defs/canonicalNonNegativeInt64"
                  },
                  "role": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "tag",
                  "maxCandidates"
                ],
                "properties": {
                  "kind": {
                    "const": "entities_by_tag"
                  },
                  "tag": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  },
                  "maxCandidates": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "role": {
                    "$ref": "native-world-common.schema.json#/$defs/nonBlankString"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "condition": {
            "$ref": "native-world-common.schema.json#/$defs/condition"
          },
          "effects": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "$ref": "native-world-common.schema.json#/$defs/eventEffect"
            }
          },
          "readResourceKeys": {
            "$ref": "native-world-common.schema.json#/$defs/resourceKeys"
          },
          "writeResourceKeys": {
            "$ref": "native-world-common.schema.json#/$defs/resourceKeys"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "native-world-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
