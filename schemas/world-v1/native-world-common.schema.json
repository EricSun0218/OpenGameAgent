{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EricSun0218/game-agent-runtime/main/schemas/world-v1/native-world-common.schema.json",
  "title": "Native World v1 Common Definitions",
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonicalInt64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|-[1-9][0-9]{0,18})$"
    },
    "canonicalNonNegativeInt64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^(?:0|[1-9][0-9]{0,18})$"
    },
    "canonicalPositiveInt64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "jsonPointer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?:[^~]|~[01])*(?:/(?:[^~]|~[01])*)*$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "authoritativeValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/authoritativeValue"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoritativeValue"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/nonBlankString"
          },
          {
            "pattern": "^(?:.*:.*|[^.]+\\..*\\..*)$"
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/authoritativeValue"
      }
    },
    "resourceKeys": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "literalEntityReference": {
      "type": "object",
      "required": [
        "entityId",
        "incarnation"
      ],
      "properties": {
        "entityId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "incarnation": {
          "$ref": "#/$defs/canonicalNonNegativeInt64"
        }
      },
      "additionalProperties": false
    },
    "eventEntityReference": {
      "oneOf": [
        {
          "const": "subject"
        },
        {
          "$ref": "#/$defs/literalEntityReference"
        }
      ]
    },
    "interactionEntityReference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:subject|target:(?:[0-9]|[1-5][0-9]|6[0-3]))$"
        },
        {
          "$ref": "#/$defs/literalEntityReference"
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "always"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "conditions"
          ],
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8192,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        },
        {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "source",
                "path",
                "operator"
              ],
              "properties": {
                "kind": {
                  "const": "path"
                },
                "source": {
                  "enum": [
                    "world",
                    "subject",
                    "trigger"
                  ]
                },
                "path": {
                  "$ref": "#/$defs/jsonPointer"
                },
                "operator": {
                  "enum": [
                    "exists",
                    "missing"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "source",
                "path",
                "operator",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "path"
                },
                "source": {
                  "enum": [
                    "world",
                    "subject",
                    "trigger"
                  ]
                },
                "path": {
                  "$ref": "#/$defs/jsonPointer"
                },
                "operator": {
                  "enum": [
                    "eq",
                    "neq",
                    "lt",
                    "lte",
                    "gt",
                    "gte"
                  ]
                },
                "value": {
                  "$ref": "#/$defs/authoritativeValue"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind",
            "tag"
          ],
          "properties": {
            "kind": {
              "const": "tag"
            },
            "tag": {
              "$ref": "#/$defs/nonBlankString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "path",
            "schemaId",
            "operator",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "fixed_point"
            },
            "source": {
              "enum": [
                "world",
                "subject",
                "trigger"
              ]
            },
            "path": {
              "$ref": "#/$defs/jsonPointer"
            },
            "schemaId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operator": {
              "enum": [
                "eq",
                "neq",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "$ref": "#/$defs/canonicalInt64"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "clockId",
            "operator",
            "tick"
          ],
          "properties": {
            "kind": {
              "const": "clock"
            },
            "clockId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operator": {
              "enum": [
                "eq",
                "neq",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "tick": {
              "$ref": "#/$defs/canonicalInt64"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "eventSetEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "set"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/eventEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "value": {
          "$ref": "#/$defs/authoritativeValue"
        }
      },
      "additionalProperties": false
    },
    "eventRemoveEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey"
      ],
      "properties": {
        "kind": {
          "const": "remove"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/eventEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "additionalProperties": false
    },
    "eventNumericEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey",
        "schemaId",
        "operation",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "numeric"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/eventEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "schemaId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "operation": {
          "enum": [
            "set",
            "add",
            "subtract",
            "consume"
          ]
        },
        "value": {
          "$ref": "#/$defs/canonicalInt64"
        }
      },
      "additionalProperties": false
    },
    "eventTransferEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "source",
        "sourcePath",
        "sourceResourceKey",
        "target",
        "targetPath",
        "targetResourceKey",
        "schemaId",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "transfer"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "source": {
          "$ref": "#/$defs/eventEntityReference"
        },
        "sourcePath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "sourceResourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "target": {
          "$ref": "#/$defs/eventEntityReference"
        },
        "targetPath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "targetResourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "schemaId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "amount": {
          "$ref": "#/$defs/canonicalPositiveInt64"
        }
      },
      "additionalProperties": false
    },
    "eventRelationshipEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "effectId",
            "source",
            "target",
            "relationshipTypeId",
            "resourceKey",
            "operation",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "relationship"
            },
            "effectId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "source": {
              "$ref": "#/$defs/eventEntityReference"
            },
            "target": {
              "$ref": "#/$defs/eventEntityReference"
            },
            "relationshipTypeId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "resourceKey": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operation": {
              "const": "upsert"
            },
            "value": {
              "$ref": "#/$defs/authoritativeValue"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "effectId",
            "source",
            "target",
            "relationshipTypeId",
            "resourceKey",
            "operation"
          ],
          "properties": {
            "kind": {
              "const": "relationship"
            },
            "effectId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "source": {
              "$ref": "#/$defs/eventEntityReference"
            },
            "target": {
              "$ref": "#/$defs/eventEntityReference"
            },
            "relationshipTypeId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "resourceKey": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operation": {
              "const": "remove"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "emitEventEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "eventKind"
      ],
      "properties": {
        "kind": {
          "const": "emit_event"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "eventKind": {
          "$ref": "#/$defs/nonBlankString"
        },
        "payload": {
          "$ref": "#/$defs/authoritativeValue"
        }
      },
      "additionalProperties": false
    },
    "eventEffect": {
      "oneOf": [
        {
          "$ref": "#/$defs/eventSetEffect"
        },
        {
          "$ref": "#/$defs/eventRemoveEffect"
        },
        {
          "$ref": "#/$defs/eventNumericEffect"
        },
        {
          "$ref": "#/$defs/eventTransferEffect"
        },
        {
          "$ref": "#/$defs/eventRelationshipEffect"
        },
        {
          "$ref": "#/$defs/emitEventEffect"
        }
      ]
    },
    "interactionSetEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "set"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/interactionEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "value": {
          "$ref": "#/$defs/authoritativeValue"
        }
      },
      "additionalProperties": false
    },
    "interactionRemoveEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey"
      ],
      "properties": {
        "kind": {
          "const": "remove"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/interactionEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "additionalProperties": false
    },
    "interactionNumericEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "entity",
        "path",
        "resourceKey",
        "schemaId",
        "operation",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "numeric"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "entity": {
          "$ref": "#/$defs/interactionEntityReference"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "resourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "schemaId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "operation": {
          "enum": [
            "set",
            "add",
            "subtract",
            "consume"
          ]
        },
        "value": {
          "$ref": "#/$defs/canonicalInt64"
        }
      },
      "additionalProperties": false
    },
    "interactionTransferEffect": {
      "type": "object",
      "required": [
        "kind",
        "effectId",
        "source",
        "sourcePath",
        "sourceResourceKey",
        "target",
        "targetPath",
        "targetResourceKey",
        "schemaId",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "transfer"
        },
        "effectId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "source": {
          "$ref": "#/$defs/interactionEntityReference"
        },
        "sourcePath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "sourceResourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "target": {
          "$ref": "#/$defs/interactionEntityReference"
        },
        "targetPath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "targetResourceKey": {
          "$ref": "#/$defs/nonBlankString"
        },
        "schemaId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "amount": {
          "$ref": "#/$defs/canonicalPositiveInt64"
        }
      },
      "additionalProperties": false
    },
    "interactionRelationshipEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "effectId",
            "source",
            "target",
            "relationshipTypeId",
            "resourceKey",
            "operation",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "relationship"
            },
            "effectId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "source": {
              "$ref": "#/$defs/interactionEntityReference"
            },
            "target": {
              "$ref": "#/$defs/interactionEntityReference"
            },
            "relationshipTypeId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "resourceKey": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operation": {
              "const": "upsert"
            },
            "value": {
              "$ref": "#/$defs/authoritativeValue"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "effectId",
            "source",
            "target",
            "relationshipTypeId",
            "resourceKey",
            "operation"
          ],
          "properties": {
            "kind": {
              "const": "relationship"
            },
            "effectId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "source": {
              "$ref": "#/$defs/interactionEntityReference"
            },
            "target": {
              "$ref": "#/$defs/interactionEntityReference"
            },
            "relationshipTypeId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "resourceKey": {
              "$ref": "#/$defs/nonBlankString"
            },
            "operation": {
              "const": "remove"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "interactionEffect": {
      "oneOf": [
        {
          "$ref": "#/$defs/interactionSetEffect"
        },
        {
          "$ref": "#/$defs/interactionRemoveEffect"
        },
        {
          "$ref": "#/$defs/interactionNumericEffect"
        },
        {
          "$ref": "#/$defs/interactionTransferEffect"
        },
        {
          "$ref": "#/$defs/interactionRelationshipEffect"
        }
      ]
    },
    "parameterSchemaNode": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "boolean",
            "null"
          ]
        },
        "required": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "$ref": "#/$defs/parameterSchemaNode"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "const": {
          "$ref": "#/$defs/jsonValue"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "items": {
          "$ref": "#/$defs/parameterSchemaNode"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "additionalProperties"
            ],
            "properties": {
              "additionalProperties": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
