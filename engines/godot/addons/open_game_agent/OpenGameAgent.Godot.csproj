<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenGameAgent.Godot</RootNamespace>
    <GodotSharpDir Condition="'$(GodotSharpDir)' == ''">$(GODOT_SHARP_DIR)</GodotSharpDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireGodotSharp" BeforeTargets="ResolveReferences" Condition="!Exists('$(GodotSharpDir)\GodotSharp.dll')">
    <Error Text="Set GodotSharpDir or GODOT_SHARP_DIR to the GodotSharp Api/Debug directory." />
  </Target>
  <ItemGroup>
    <Compile Include="runtime\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(GodotSharpDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\OpenGameAgent.Client\OpenGameAgent.Client.csproj" />
    <ProjectReference Include="..\..\..\..\src\OpenGameAgent\OpenGameAgent.csproj" />
  </ItemGroup>
</Project>
