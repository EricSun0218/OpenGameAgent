<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>OpenGameAgent.Unity</RootNamespace>
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">$(UNITY_MANAGED_DIR)</UnityManagedDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireUnity" BeforeTargets="ResolveReferences" Condition="!Exists('$(UnityManagedDir)\UnityEngine.CoreModule.dll')">
    <Error Text="Set UnityManagedDir or UNITY_MANAGED_DIR to the Unity Editor Data/Managed/UnityEngine directory." />
  </Target>
  <ItemGroup>
    <Compile Include="Packages\com.opengameagent.runtime\Runtime\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenGameAgent.Client\OpenGameAgent.Client.csproj" />
    <ProjectReference Include="..\..\src\OpenGameAgent\OpenGameAgent.csproj" />
  </ItemGroup>
</Project>
