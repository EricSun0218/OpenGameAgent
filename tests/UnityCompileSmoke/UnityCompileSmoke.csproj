<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameAgent.Unity.CompileSmoke</AssemblyName>
    <RootNamespace>GameAgent.Unity</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UnityArtifactPath)' == ''">
    <Compile Include="..\..\engines\unity\com.gameagent.runtime.unity\Runtime\**\*.cs"
             Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\engines\unity\com.gameagent.runtime.unity\Samples~\**\*.cs"
             Link="Samples\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\engines\unity\com.gameagent.runtime.unity\Tests\**\*.cs"
             Link="PackageTests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityArtifactPath)' == ''">
    <ProjectReference Include="..\..\src\GameAgent.Protocol\GameAgent.Protocol.csproj" />
    <ProjectReference Include="..\..\src\GameAgent.Core\GameAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\GameAgent.Persistence\GameAgent.Persistence.csproj" />
    <ProjectReference Include="..\..\src\GameAgent.Providers.OpenAICompatible\GameAgent.Providers.OpenAICompatible.csproj" />
    <ProjectReference Include="..\..\src\GameAgent.Runtime\GameAgent.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityArtifactPath)' != ''">
    <Compile Include="$(UnityArtifactPath)\Runtime\**\*.cs"
             Exclude="$(UnityArtifactPath)\Runtime\Plugins\**"
             Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(UnityArtifactPath)\Samples~\**\*.cs"
             Link="Samples\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(UnityArtifactPath)\Tests\**\*.cs"
             Link="PackageTests\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="GameAgent.Protocol"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\GameAgent.Protocol.dll"
               Private="false" />
    <Reference Include="GameAgent.Core"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\GameAgent.Core.dll"
               Private="false" />
    <Reference Include="GameAgent.Persistence"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\GameAgent.Persistence.dll"
               Private="false" />
    <Reference Include="GameAgent.Providers.OpenAICompatible"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\GameAgent.Providers.OpenAICompatible.dll"
               Private="false" />
    <Reference Include="GameAgent.Runtime"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\GameAgent.Runtime.dll"
               Private="false" />
    <Reference Include="System.Text.Json"
               HintPath="$(UnityArtifactPath)\Runtime\Plugins\System.Text.Json.dll"
               Private="false" />
  </ItemGroup>
  <Target Name="ValidateUnityArtifactPath"
          BeforeTargets="ResolveReferences"
          Condition="'$(UnityArtifactPath)' != ''">
    <Error Condition="!Exists('$(UnityArtifactPath)\package.json')"
           Text="UnityArtifactPath does not identify a package artifact." />
  </Target>
</Project>
