<Project>
  <Import Project="..\Directory.Build.props" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
    <!-- Override legacy transitive test-runner dependencies with maintained builds. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
