{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/coverage",
			"!!**/.benchmark-data",
			"!!**/node_modules",
			"!!**/bin",
			"!!**/obj",
			"!!**/build",
			"!!**/build-*",
			"!!**/.godot",
			"!!**/Library",
			"!!**/Logs",
			"!!**/Temp",
			"!!**/UserSettings"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "!!packages/client/src/generated/**"],
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
